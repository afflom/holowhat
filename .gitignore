# Generated by Cargo
# will have compiled files and executables
debug
target
vendor/
_site/
.DS_Store
**/target/
**/vendor/
**/_site/
**/.DS_Store


# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
# JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Node.js dependencies
**/node_modules/
**/package-lock.json

# Web Frontend generated/symlinked assets (imported dynamically from Playground)
crates/holospaces-web/web/blocks/
crates/holospaces-web/web/utils/
crates/holospaces-web/web/assets/css/
crates/holospaces-web/web/assets/icons/
crates/holospaces-web/web/assets/img/
crates/holospaces-web/web/assets/scripts/*
!crates/holospaces-web/web/assets/scripts/playground.js
crates/holospaces-web/web/*.html

# Generated web/browser fixtures
crates/holospaces-web/web/fixture.holo
crates/holospaces-web/web/fixture.kappa
crates/holospaces-web/web/fixture-userland.wasm



